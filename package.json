{
  "name": "wzsc-collector",
  "version": "0.2.0",
  "description": "把网页文章（微信公众号 / 知乎 / 微博 / X / 通用网页）采集为 Markdown，存进个人收藏仓库",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "install-addon": "node install.js",
    "test": "node tools/markdown-selftest.js",
    "test:browser": "node tools/browser-selftest.js",
    "test:all": "npm test && npm run test:browser"
  },
  "dependencies": {
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
